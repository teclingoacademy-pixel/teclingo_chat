# GEMINI_API_KEY: Required for the primary Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional fallback AI (OpenAI-compatible). Used if Gemini fails.
GROQ_API_KEY="MY_GROQ_API_KEY"

# OMNIROUTE_API_KEY: Optional OmniRoute router (OpenAI-compatible). When set, it becomes
# the PRIMARY provider with multi-provider routing + auto-fallback (291 providers, free tiers).
# Leave empty to keep Gemini primary and skip OmniRoute.
OMNIROUTE_API_KEY=""

# OMNIROUTE_BASE_URL: Where the OmniRoute server runs (default: the teclingo VPS).
OMNIROUTE_BASE_URL="http://192.168.0.15:20128"

# OMNIROUTE_MODEL: Model name OmniRoute should resolve (a provider model or a combo group).
OMNIROUTE_MODEL="gpt-4o-mini"
